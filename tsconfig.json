{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "ES6",
    "moduleResolution": "node",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "isolatedModules": true,
    "lib": ["DOM", "ES5", "ES6", "ES7", "ES2018"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["main.ts", "src/**/*.ts"]
}
