{
  "name": "obsidian-prompt-colorizer",
  "version": "2.7.0",
  "description": "根据 Markdown 文件类型和内容模式自动着色，优化 AI 提示词的编写与展示体验。",
  "author": "芝世",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
